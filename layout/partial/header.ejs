<header class="site-header">
  <div class="header-inner">
    <a class="site-title" href="<%- url_for('/') %>"><img class="site-logo" src="<%- url_for('/images/logo.svg') %>" alt="Logo"><%= config.title %></a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span class="nav-toggle-icon"></span>
    </button>
    <nav class="site-nav">
      <% for (var name in theme.menu) { %>
        <a class="nav-link" href="<%- url_for(theme.menu[name]) %>"><%= name %></a>
      <% } %>
      <button class="search-toggle" type="button" aria-label="搜索文章" aria-expanded="false" aria-controls="search-panel" title="搜索文章">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"/>
          <path d="m20 20-4-4"/>
        </svg>
      </button>
      <button class="theme-toggle" type="button" aria-label="切换主题" title="切换主题" data-theme-state="light">
        <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </nav>
  </div>
  <div class="search-panel" id="search-panel" role="dialog" aria-label="搜索文章" aria-modal="false" data-search-path="<%- url_for('/search.json') %>" hidden>
    <div class="search-panel-inner">
      <div class="search-panel-header">
        <label class="search-label" for="search-input">搜索文章</label>
        <button class="search-close" type="button" aria-label="关闭搜索" title="关闭搜索">&times;</button>
      </div>
      <input class="search-input" id="search-input" type="search" placeholder="输入标题或正文关键词" autocomplete="off" spellcheck="false">
      <p class="search-status" id="search-status" role="status" aria-live="polite"></p>
      <ul class="search-results" id="search-results"></ul>
    </div>
  </div>
</header>
