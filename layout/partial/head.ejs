<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
  <title><%= page.title ? page.title + ' | ' : '' %><%= config.title %></title>
  <%- open_graph() %>
  <link rel="icon" href="<%- url_for('/images/logo.svg') %>">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-serif-sc@5.3.0/700.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@chinese-fonts/maple-mono-cn@2.0.0/dist/MapleMono-CN-Regular/result.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">

  <link rel="stylesheet" href="https://ai.zhheo.com/static/public/tianli_gpt.min.css">
  <script>
  let tianliGPT_postSelector = '#postchat_postcontent';
  let tianliGPT_key = 'S-ATO0KVLITZYEXIH6';
  let tianliGPT_theme = 'menghuan';
  </script>
  <script src="https://ai.zhheo.com/static/public/tianli_gpt.min.js"></script>

  <%- css('css/callout_blocks') %>
  <% if (theme.waline && theme.waline.enable) { %>
    <%- css('css/waline') %>
  <% } %>
  <% if (theme.giscus && theme.giscus.enable) { %>
    <%- css('css/giscus') %>
  <% } %>
  <% if (theme.catcounter && theme.catcounter.enable) { %>
    <%- css('css/catcounter') %>
  <% } %>
  <% if ((page.math !== undefined) ? page.math : (theme.math && theme.math.enable)) { %>
    <%- css('css/math') %>
    <%- partial('math') %>
  <% } %>
  <%- css('css/style') %>
  <%# Inline to avoid FOUC. Storage key kept in sync with source/js/main.js %>
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('warmpaper-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    })();
  </script>
</head>
