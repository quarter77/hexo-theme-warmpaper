<footer class="site-footer">
  <div class="footer-inner">
    <% if (theme.copyright) { %>
      <p><%- theme.copyright %></p>
    <% } else { %>
      <p>&copy; <%= new Date().getFullYear() %> <%= config.author || config.title %></p>
    <% } %>
    <% if (theme.catcounter && theme.catcounter.enable && theme.catcounter.show_site !== false) { %>
      <p class="site-stats"><%= theme.catcounter.label_site_pv || '总访问' %> <span data-cc="site_pv">-</span> &middot; <%= theme.catcounter.label_site_uv || '访客' %> <span data-cc="site_uv">-</span></p>
    <% } %>
    <p>Powered by <a href="https://hexo.io/" target="_blank" rel="noopener">Hexo</a> &middot; Theme <a href="https://github.com/finch-xu/hexo-theme-warmpaper" target="_blank" rel="noopener">Warmpaper</a></p>
  </div>
</footer>
